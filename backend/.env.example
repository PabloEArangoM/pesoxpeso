PORT=3000
DATABASE_URL=postgres://pxp:pxp@localhost:5432/pesoxpeso
# Genera secretos largos y distintos:  openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-largo
# Dominio(s) del frontend, separados por coma. "*" solo sirve en desarrollo:
# con NODE_ENV=production el servidor no arranca si queda en "*".
CORS_ORIGIN=http://localhost:5173
# Intentos por IP cada 15 min en /auth/login y /auth/registro
RATE_LIMIT_AUTH_MAX=20

# URL pública del frontend: con ella se arman los enlaces de los correos.
APP_URL=http://localhost:5173

# Correo (verificación y contraseña olvidada). Sin SMTP_URL no se envía nada:
# el mensaje, con su enlace, se escribe en el log del servidor.
# SMTP_URL=smtps://usuario:clave@smtp.ejemplo.com:465
# EMAIL_FROM=PesoXPeso <no-responder@tudominio.com>

# Recordatorios por notificación push. Genera el par una sola vez con:
#   npx web-push generate-vapid-keys
# Sin estas llaves la app simplemente no ofrece activar los recordatorios.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Nivel de log: debug, info, warn, error
# LOG_LEVEL=info
